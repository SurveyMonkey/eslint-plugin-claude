{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "**/*.mjs",
      "**/*.ts",
      "**/*.md",
      "**/*.yml",
      "**/*.yaml",
      "!.release-please-manifest.json",
      "!tests/fixtures/**/*.md",
      "!tests/fixtures/**/*.yml",
      "!tests/fixtures/**/*.yaml",
      "!CHANGELOG.md",
      "!pnpm-lock.yaml",
      "!docs/rules-inventory.md"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  }
}
