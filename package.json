{
  "name": "eslint-plugin-claude",
  "version": "0.12.0",
  "description": "An ESLint plugin that lints Claude Code configuration: CLAUDE.md, skills, subagents, hooks, settings, permissions, MCP servers, and plugin manifests.",
  "keywords": [
    "claude-code",
    "claude-md",
    "claude-code-skills",
    "subagents",
    "claude-code-hooks",
    "mcp",
    "model-context-protocol",
    "claude-code-plugins",
    "plugin-marketplace",
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "linter",
    "lint",
    "anthropic"
  ],
  "homepage": "https://github.com/SurveyMonkey/eslint-plugin-claude#readme",
  "bugs": {
    "url": "https://github.com/SurveyMonkey/eslint-plugin-claude/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurveyMonkey/eslint-plugin-claude.git"
  },
  "license": "MIT",
  "author": {
    "name": "Brian Espinosa",
    "email": "b@bje.co"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "docs:check": "pnpm build && eslint-doc-generator --check",
    "docs:generate": "pnpm build && eslint-doc-generator",
    "docs:seed": "node scripts/seed-rule-sources.ts",
    "docs:update": "node scripts/docs-watch.ts update",
    "knip": "pnpm build && knip && knip --strict",
    "lint": "biome ci . --error-on-warnings && node --disable-warning=ExperimentalWarning node_modules/eslint/bin/eslint.js src/rules",
    "prepack": "pnpm run build",
    "publint": "pnpm build && publint --strict",
    "test": "vitest run --coverage && node scripts/check-coverage.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-doc-generator": "3.7.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "espree": "11.2.0",
    "knip": "6.41.0",
    "lefthook": "2.2.1",
    "publint": "0.3.25",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.0",
    "eslint": "^10.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.18.0",
      "onFail": "warn"
    }
  }
}
