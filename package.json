{
  "name": "eslint-plugin-claude",
  "version": "0.1.0",
  "description": "An ESLint plugin that lints Claude Code configuration files.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "claude",
    "claude-code"
  ],
  "homepage": "https://github.com/SurveyMonkey/eslint-plugin-claude#readme",
  "bugs": {
    "url": "https://github.com/SurveyMonkey/eslint-plugin-claude/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SurveyMonkey/eslint-plugin-claude.git"
  },
  "license": "MIT",
  "author": {
    "name": "Brian Espinosa",
    "email": "b@bje.co"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "knip": "pnpm build && knip && knip --strict",
    "lint": "biome ci . --error-on-warnings",
    "prepack": "pnpm run build",
    "publint": "pnpm build && publint --strict",
    "test": "vitest run --coverage && node scripts/check-coverage.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "publint": "0.3.24",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "peerDependencies": {
    "@eslint/json": "^2.0.0",
    "@eslint/markdown": "^8.0.0",
    "eslint": "^10.0.0"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
